APP_ENV=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ai_study_planner
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI: "mock" works offline (limited subjects). "gemini" = real AI for ANY subject.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OTP: demo=true prints OTP in the server console + API response (development only!)
OTP_DEMO_MODE=true
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
# Real email OTP (Gmail: use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Real SMS OTP (India): SMS_PROVIDER=fast2sms
SMS_PROVIDER=
FAST2SMS_API_KEY=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
